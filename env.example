# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Supabase (public anon key for client-side reads)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (server-only — never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Notion OAuth
# Create an integration at https://www.notion.so/profile/integrations
# Set the redirect URI to: {APP_URL}/api/notion/callback
NOTION_CLIENT_ID=your-notion-oauth-client-id
NOTION_CLIENT_SECRET=your-notion-oauth-client-secret
NOTION_REDIRECT_URI=http://localhost:3000/api/notion/callback

# Encryption secret for stored OAuth tokens (32 bytes hex = 64 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=replace-with-64-char-hex-string

# App URL (used for redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
